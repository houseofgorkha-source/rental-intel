NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Ola Maps Web SDK key -- deliberately a SEPARATE key from tools/tolet-vision's
# server-side OLA_MAPS_API_KEY (the crawler's own, budget-tracked at up to
# 400,000 requests/month). This one ships in the browser bundle and is
# visible to anyone, so never reuse the crawler's key here -- get a
# dedicated key from the Krutrim Cloud dashboard instead.
NEXT_PUBLIC_OLA_MAPS_API_KEY=your-ola-maps-web-sdk-key

# Dev-only: adds a "Pages" section to the Account menu linking every route
# in the app, for quick navigation during development. Leave unset (or
# false) in production -- must be removed/false before launch.
NEXT_PUBLIC_SHOW_DEV_NAV=false

# The real production URL, used to build robots.txt/sitemap.xml absolute
# links. Set this to whatever domain you actually deploy to (a Vercel
# subdomain is fine); falls back to a placeholder if unset so local dev
# never needs it.
NEXT_PUBLIC_SITE_URL=https://rentalintel.vercel.app
